// srt settings template — @anthropic-ai/sandbox-runtime, PINNED 0.0.65.
//
// Rendered per worker by render_settings.py, which substitutes the %%…%%
// placeholders and STRIPS these // comments: srt parses settings with
// JSON.parse (dist/utils/config-loader.js), which rejects comments outright.
// Justifications live here, in the template, and never reach the rendered file.
//
// SCHEMA (verified against the pinned tarball's zod schema, not the README:
// dist/sandbox/sandbox-config.js). These five keys are NON-optional —
// network.allowedDomains, network.deniedDomains, filesystem.denyRead,
// filesystem.allowWrite, filesystem.denyWrite. Drop any one and loadConfig()
// returns null and srt exits 1 ("Refusing to run with the default config").
// Write is allow-only with denyWrite taking precedence; read is deny-then-allow;
// network is allow-only with deniedDomains checked first.
//
// Literal absolute paths only — macOS supports globs, Linux does not, so one
// template serves both platforms.
{
  "filesystem": {
    // The worker writes ONLY under its own per-worker scratch directory. The
    // launcher puts everything the worker needs there: a `git clone
    // --no-hardlinks` of the worktree (its cwd, so srt's cwd-anchored .git/hooks
    // and .git/config denies now cover the repository it can actually write),
    // an isolated HOME and CLAUDE_CONFIG_DIR, XDG_* dirs, TMPDIR, worker.log
    // and this settings file. Nothing else is writable: not the real HOME, not
    // ~/.claude or ~/.claude.json, not the shared $TMPDIR, not the primary .git
    // (so the primary refs, hooks and config cannot be touched). Anything absent
    // is EPERM at the syscall — that denial IS the feature.
    "allowWrite": [
      "%%SCRATCH%%",
      // Claude Code's per-project state dir for THIS worker's cwd only
      // (/tmp/claude-<uid>/<slug-of-cwd>, slug = cwd with / -> -). Not
      // configurable by any flag, and OUTSIDE the scratch dir: macOS resolves
      // /tmp to /private/tmp. Without this entry a worker writes its first file
      // and then dies at its NEXT tool call with "EPERM: operation not
      // permitted, mkdir '/private/tmp/claude-<uid>/<slug>'" (observed live).
      // Scoped to this worker's OWN slug, never the whole /tmp/claude-<uid>
      // tree, which would hand every worker write access over every other
      // project's session state.
      "%%CLAUDE_PROJECT_STATE%%"
    ],
    // Nothing is carved out of the scratch tree: the worker owns its clone.
    // Required key, present and deliberately empty.
    "denyWrite": [],
    // Read containment is an explicit non-goal (spec): deny-read breaks
    // toolchains constantly. Reads under the real HOME remain possible; GitHub
    // network egress is blocked below so a readable GitHub token cannot be
    // used to bypass the launcher publication path.
    // Required key, so it is present and deliberately empty.
    "denyRead": []
    // allowGitConfig deliberately OMITTED (defaults false), so srt emits its
    // .git/config deny for the cwd repository — now the scratch clone.
    //
    // NOTE: the worker no longer pushes. The launcher imports the worker's
    // branch from the clone after exit and pushes it from outside the sandbox.
  },
  "network": {
    // Allow-only: srt denies all egress by default. An incomplete list fails
    // LOUDLY (blocked egress), never silently. Extend only from probe evidence.
    "allowedDomains": [
      // The worker's own claude -p process talks to the Anthropic API.
      "api.anthropic.com"
    ],
    // Required key (non-optional in the schema). Empty: the allowlist above is
    // the whole policy, and deniedDomains would only ever subtract from it.
    "deniedDomains": []
  }
}
