#!/usr/bin/env python3
"""Run strict changed-source checks and isolated Python suites before a commit."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def main() -> int:
    """Preserve check ordering and stop immediately on either quality or test failure."""
    repository = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False)
    if repository.returncode:
        print(repository.stderr, file=sys.stderr, end="")
        return repository.returncode
    root = Path(repository.stdout.strip())
    environment = os.environ.copy()
    for key in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_PREFIX"):
        environment.pop(key, None)
    commands = (
        ("strict source-quality checks", [sys.executable, "scripts/quality/check.py", "--strict", "--changed"]),
        ("Python test suites", [sys.executable, "hooks/scripts/tests/run_all.py"]),
    )
    for label, command in commands:
        print(f"pre-commit: {label}", flush=True)
        code = subprocess.run(command, cwd=root, env=environment, check=False).returncode
        if code:
            return code if code > 0 else 128 - code
    print("pre-commit: OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
