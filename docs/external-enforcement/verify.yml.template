# INERT TEMPLATE. Nothing runs until a human copies this to .github/workflows/verify.yml and re-enables Actions.
# See docs/external-enforcement/README.md before doing so.
name: verify
on:
  pull_request:
permissions:
  contents: read
  pull-requests: read
jobs:
  verify:
    runs-on: ubuntu-latest
    env:
      GH_TOKEN: ${{ github.token }}
      # Pinned: GITHUB_TOKEN usually fails `gh api user`, which would otherwise be a FETCH_FAIL.
      _PR_TRUSTED_LOGIN: blueman82
      _PR_TRUSTED_PERMISSION: WRITE
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0   # smoke_verify runs `git fetch origin <sha>` and adds a worktree
      - uses: actions/setup-python@v5
        with:
          python-version: "3.9"
      - run: python3 scripts/ci_verify.py --pr ${{ github.event.pull_request.number }} --sha ${{ github.event.pull_request.head.sha }}
