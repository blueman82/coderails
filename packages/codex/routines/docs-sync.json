{
  "routine": "docs-sync",
  "stages": ["fetch_branch", "evals_frozen", "edit_made", "manifest_check", "push", "review", "post_review", "post_evals", "merge"],
  "policy": "policy/docs-sync.policy.json",
  "log": "~/.codex/coderails-dashboard/routines/docs-sync/run-{date}.log",
  "cleanup": ["close_pr", "delete_remote_branch", "delete_local_branch"],
  "reason_codes": [
    "incomplete-run", "stage_out_of_order", "runner_exit_no_terminal", "audit_failed",
    "out_of_manifest", "denied_path", "docs_sync_deny", "docs_sync_deletion", "special_file_type",
    "status_not_allowed", "too_many_paths", "not_linked_worktree", "manifest_unreadable", "manifest_internal_error",
    "push", "review", "post_review", "post_evals", "merge"
  ]
}
