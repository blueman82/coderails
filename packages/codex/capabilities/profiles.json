{
  "schema_version": 1,
  "capabilities": ["repo.inspect", "diff.read", "tests.run", "pr.comment", "cmd.run", "worktree.write", "shell.raw"],
  "agents": {
    "deploy-safety-reviewer": ["repo.inspect", "diff.read"],
    "design-scout": ["repo.inspect", "diff.read"],
    "disposition-scout": ["repo.inspect", "diff.read"],
    "preflight-scout": ["repo.inspect", "diff.read"],
    "source-auditor": ["repo.inspect", "diff.read", "tests.run", "cmd.run"],
    "spec-reviewer": [],
    "docs-auditor": ["shell.raw", "worktree.write"],
    "loop-worker": ["shell.raw", "worktree.write"],
    "proof-author": ["shell.raw", "worktree.write"],
    "wiki-writer": ["shell.raw", "worktree.write"]
  },
  "named_commands": {
    "git-rev-count": {"argv": ["git", "rev-list", "--count", "{ref}"], "params": {"ref": "ref"}},
    "file-lines": {"argv": ["wc", "-l", "{path}"], "params": {"path": "repo_path"}},
    "file-sha256": {"argv": ["shasum", "-a", "256", "{path}"], "params": {"path": "repo_path"}}
  },
  "tests": {
    "scripts": ["python3", "-m", "unittest", "discover", "-s", "scripts/tests", "-p", "*_test.py"],
    "packages": ["python3", "-m", "unittest", "discover", "-s", "packages/tests", "-p", "*test*.py"],
    "reviewer-allowlist": ["python3", "hooks/scripts/tests/reviewer_bash_allowlist_test.py"]
  }
}
